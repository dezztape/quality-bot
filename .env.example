# Quality Bot Environment Configuration
# Copy this file to .env and fill in your actual values

# Telegram Bot Token - get from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Database URL - format: postgresql+asyncpg://user:password@host/database
# Local development: postgresql+asyncpg://postgres:password@localhost/quality_bot
# Railway (auto-generated): Use the RAILWAY_DATABASE_URL variable
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/quality_bot

# Admin IDs - comma-separated list of Telegram user IDs (get with /start command)
# Admins can: add questions, view/approve tests, see statistics, send notifications
ADMIN_IDS=123456789,987654321

# Redis URL (optional) - for production deployment
# Format: redis://default:password@hostname:port
# Set this on Railway to use Redis for FSM state storage
REDIS_URL=
